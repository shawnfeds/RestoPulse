{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Authority": "https://your-identity-provider.com",
    "Audience": "restopulse-api"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "ReverseProxy": {
    "Routes": {
      "menu-route": {
        "ClusterId": "menu-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/menu/{**catch-all}" }
      },
      "table-route": {
        "ClusterId": "table-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/tables/{**catch-all}" }
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "kitchen-route": {
        "ClusterId": "kitchen-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/kitchen/{**catch-all}" }
      },
      "billing-route": {
        "ClusterId": "billing-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/bills/{**catch-all}" }
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/inventory/{**catch-all}" }
      },
      "report-route": {
        "ClusterId": "report-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/reports/{**catch-all}" }
      }
    },
    "Clusters": {
      "menu-cluster": { "Destinations": { "d1": { "Address": "http://menuservice" } } },
      "table-cluster": { "Destinations": { "d1": { "Address": "http://tableservice" } } },
      "order-cluster": { "Destinations": { "d1": { "Address": "http://orderservice" } } },
      "kitchen-cluster": { "Destinations": { "d1": { "Address": "http://kitchenservice" } } },
      "billing-cluster": { "Destinations": { "d1": { "Address": "http://billingservice" } } },
      "inventory-cluster": { "Destinations": { "d1": { "Address": "http://inventoryservice" } } },
      "report-cluster": { "Destinations": { "d1": { "Address": "http://reportservice" } } }
    }
  }
}