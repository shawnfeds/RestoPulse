{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Authority": "",
    "Audience": "restopulse-api"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "WindowSeconds": 60,
    "SegmentsPerWindow": 6,
    "QueueLimit": 1000
  },
  "ReverseProxy": {
    "Routes": {
      "menu-route": {
        "ClusterId": "menu-cluster",
        "AuthorizationPolicy": "RestroAuth",
        "RateLimiterPolicy": "sliding-policy",
        "Match": { "Path": "/api/menu/{**catch-all}" }
      },
      "table-route": {
        "ClusterId": "table-cluster",
        "AuthorizationPolicy": "RestroAuth",
        "RateLimiterPolicy": "sliding-policy",
        "Match": { "Path": "/api/tables/{**catch-all}" }
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "AuthorizationPolicy": "RestroAuth",
        "RateLimiterPolicy": "sliding-policy",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "kitchen-route": {
        "ClusterId": "kitchen-cluster",
        "AuthorizationPolicy": "RestroAuth",
        "RateLimiterPolicy": "sliding-policy",
        "Match": { "Path": "/api/kitchen/{**catch-all}" }
      },
      "billing-route": {
        "ClusterId": "billing-cluster",
        "AuthorizationPolicy": "RestroAuth",
        "RateLimiterPolicy": "sliding-policy",
        "Match": { "Path": "/api/bills/{**catch-all}" }
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy": "RestroAuth",
        "RateLimiterPolicy": "sliding-policy",
        "Match": { "Path": "/api/inventory/{**catch-all}" }
      },
      "report-route": {
        "ClusterId": "report-cluster",
        "AuthorizationPolicy": "RestroAuth",
        "RateLimiterPolicy": "sliding-policy",
        "Match": { "Path": "/api/reports/{**catch-all}" }
      },
      "dashboard-route": {
        "ClusterId": "report-cluster",
        "AuthorizationPolicy": "RestroAuth",
        "RateLimiterPolicy": "sliding-policy",
        "Match": { "Path": "/api/dashboard/{**catch-all}" }
      },
      "user-login-route": {
        "ClusterId": "user-cluster",
        "RateLimiterPolicy": "sliding-policy",
        "Match": { "Path": "/api/users/login" }
      },
      "user-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "RestroAuth",
        "RateLimiterPolicy": "sliding-policy",
        "Match": { "Path": "/api/users/{**catch-all}" }
      }
    },
    "Clusters": {
      "menu-cluster": { "Destinations": { "d1": { "Address": "https+http://menu-service" } } },
      "table-cluster": { "Destinations": { "d1": { "Address": "https+http://table-service" } } },
      "order-cluster": { "Destinations": { "d1": { "Address": "https+http://order-service" } } },
      "kitchen-cluster": { "Destinations": { "d1": { "Address": "https+http://kitchen-service" } } },
      "billing-cluster": { "Destinations": { "d1": { "Address": "https+http://billing-service" } } },
      "inventory-cluster": { "Destinations": { "d1": { "Address": "https+http://inventory-service" } } },
      "report-cluster": { "Destinations": { "d1": { "Address": "https+http://report-service" } } },
      "user-cluster": { "Destinations": { "d1": { "Address": "https+http://user-service" } } }
    }
  }
}